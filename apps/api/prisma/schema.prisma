datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProviderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model AdminUser {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  isSuspended    Boolean   @default(false) @map("is_suspended")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("admin_users")
}

model Customer {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?        @unique @map("firebase_uid") @db.VarChar(128)
  mobileNumber String         @unique @map("mobile_number") @db.VarChar(20)
  displayName  String?        @map("display_name") @db.VarChar(150)
  isSuspended  Boolean        @default(false) @map("is_suspended")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  addresses       CustomerAddress[]
  bookings        Booking[]
  idempotencyKeys IdempotencyKey[]
  slotLocks       BookingSlotLock[]
  paymentOrders   PaymentOrder[]
  ratings         Rating[]

  @@map("customers")
}

model Provider {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?        @unique @map("firebase_uid") @db.VarChar(128)
  mobileNumber String         @unique @map("mobile_number") @db.VarChar(20)
  displayName  String         @map("display_name") @db.VarChar(150)
  status       ProviderStatus @default(PENDING_REVIEW)
  serviceArea  String         @map("service_area") @db.VarChar(100)
  lastActiveAt DateTime?      @map("last_active_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bookings     Booking[]
  categories   ServiceCategory[]
  ratings      Rating[]

  @@index([status, mobileNumber], map: "idx_providers_status_mobile")
  @@map("providers")
}

model RefreshToken {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  userRole         String         @map("user_role") @db.VarChar(50)
  tokenHash        String         @unique @map("token_hash") @db.VarChar(64)
  tokenFamilyId    String         @map("token_family_id") @db.Uuid
  parentId         String?        @map("parent_id") @db.Uuid
  isRevoked        Boolean        @default(false) @map("is_revoked")
  revocationReason String?        @map("revocation_reason") @db.VarChar(100)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz
  lastActivity     DateTime       @default(now()) @map("last_activity") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  
  parent           RefreshToken?  @relation("TokenHistory", fields: [parentId], references: [id], onDelete: SetNull)
  children         RefreshToken[] @relation("TokenHistory")

  @@index([tokenFamilyId], map: "idx_refresh_tokens_family")
  @@index([userId, userRole], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldState   Json?    @map("old_state")
  newState   Json?    @map("new_state")
  requestId  String?  @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model ServiceCategory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @unique @db.VarChar(100)
  description  String?   @db.Text
  iconUrl      String?   @map("icon_url") @db.Text
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  services     Service[]
  providers    Provider[]

  @@map("service_categories")
}

model Service {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId        String          @map("category_id") @db.Uuid
  name              String          @db.VarChar(150)
  description       String?         @db.Text
  fixedPrice        Decimal         @map("fixed_price") @db.Decimal(12, 2)
  estimatedDuration String?         @map("estimated_duration") @db.VarChar(50)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings          Booking[]
  paymentOrders     PaymentOrder[]

  @@unique([categoryId, name], map: "uq_service_name_category")
  @@index([categoryId], map: "idx_services_category_id")
  @@map("services")
}

model CatalogVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionHash String   @map("version_hash") @db.VarChar(64)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("catalog_versions")
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  STARTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH_ON_SERVICE
  ONLINE
}

model CustomerAddress {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  label        String    @db.VarChar(50)
  addressLine1 String    @map("address_line_1") @db.Text
  addressLine2 String?   @map("address_line_2") @db.Text
  city         String    @db.VarChar(100)
  pincode      String    @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  paymentOrders PaymentOrder[]

  @@index([customerId], map: "idx_addresses_customer_id")
  @@map("customer_addresses")
}

model BookingTimeSlot {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label        String            @db.VarChar(100)
  startTime    DateTime          @map("start_time") @db.Time
  endTime      DateTime          @map("end_time") @db.Time
  isActive     Boolean           @default(true) @map("is_active")
  displayOrder Int               @default(0) @map("display_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  locks        BookingSlotLock[]
  bookings     Booking[]
  paymentOrders PaymentOrder[]

  @@map("booking_time_slots")
}

model Booking {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingReference     String                 @unique @map("booking_reference") @db.VarChar(30)
  customerId           String                 @map("customer_id") @db.Uuid
  providerId           String?                @map("provider_id") @db.Uuid
  serviceId            String                 @map("service_id") @db.Uuid
  serviceNameSnapshot  String                 @map("service_name_snapshot") @db.VarChar(150)
  servicePriceSnapshot Decimal                @map("service_price_snapshot") @db.Decimal(12, 2)
  addressId            String?                @map("address_id") @db.Uuid
  addressSnapshot      Json                   @map("address_snapshot")
  slotDate             DateTime               @map("slot_date") @db.Date
  slotId               String?                @map("slot_id") @db.Uuid
  slotLabelSnapshot    String                 @map("slot_label_snapshot") @db.VarChar(100)
  paymentMethod        PaymentMethod          @map("payment_method")
  status               BookingStatus          @default(PENDING)
  idempotencyKey       String                 @map("idempotency_key") @db.Uuid
  rejectionReason      String?                @map("rejection_reason") @db.Text
  cancelledAt          DateTime?              @map("cancelled_at") @db.Timestamptz
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer             Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider             Provider?              @relation(fields: [providerId], references: [id], onDelete: SetNull)
  service              Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  address              CustomerAddress?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  slot                 BookingTimeSlot?       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  statusHistory        BookingStatusHistory[]
  locks                BookingSlotLock[]
  paymentOrders        PaymentOrder[]
  rating               Rating?

  @@index([customerId, status], map: "idx_bookings_customer_status")
  @@index([providerId, status], map: "idx_bookings_provider_status")
  @@index([status, slotDate], map: "idx_bookings_status_slot_date")
  @@index([slotDate], map: "idx_bookings_slot_date")
  @@index([createdAt], map: "idx_bookings_created_at")
  @@index([status, providerId, createdAt], map: "idx_bookings_status_provider_created")
  @@index([status, paymentMethod, updatedAt], map: "idx_bookings_status_paymethod_updated")
  @@map("bookings")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseCode   Int      @map("response_code")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, idempotencyKey], map: "uq_customer_idempotency")
  @@map("idempotency_keys")
}

model BookingStatusHistory {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  actorId   String        @map("actor_id") @db.Uuid
  actorRole String        @map("actor_role") @db.VarChar(50)
  note      String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "idx_bsh_booking_id")
  @@map("booking_status_history")
}

model BookingSlotLock {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slotId     String          @map("slot_id") @db.Uuid
  slotDate   DateTime        @map("slot_date") @db.Date
  customerId String          @map("customer_id") @db.Uuid
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz
  bookingId  String?         @map("booking_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  slot       BookingTimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([slotDate, slotId], map: "uq_slot_lock_date_slot")
  @@map("booking_slot_locks")
}

model OtpAttempt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mobileNumber   String    @map("mobile_number") @db.VarChar(20)
  role           String    @default("CUSTOMER") @db.VarChar(50)
  otpHash        String    @map("otp_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  usedAt         DateTime? @map("used_at") @db.Timestamptz
  failedAttempts Int       @default(0) @map("failed_attempts")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([mobileNumber, role], map: "idx_otp_attempts_mobile_role")
  @@map("otp_attempts")
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  CASH_PENDING
  CASH_SETTLED
  CANCELLED
}

model PaymentOrder {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  bookingId         String?       @map("booking_id") @db.Uuid
  bookingDraftId    String?       @map("booking_draft_id") @db.VarChar(255)
  serviceId         String?       @map("service_id") @db.Uuid
  slotId            String?       @map("slot_id") @db.Uuid
  slotDate          DateTime?     @map("slot_date") @db.Date
  addressId         String?       @map("address_id") @db.Uuid
  razorpayOrderId   String?       @map("razorpay_order_id") @db.VarChar(255)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(255)
  razorpaySignature String?       @map("razorpay_signature") @db.VarChar(255)
  amountPaise       Int           @map("amount_paise")
  paymentMethod     PaymentMethod @default(ONLINE) @map("payment_method")
  status            PaymentStatus @default(PAYMENT_PENDING)
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(255)
  failureReason     String?       @map("failure_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking           Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  slot              BookingTimeSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  address           CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([customerId, status], map: "idx_payment_orders_customer_status")
  @@index([razorpayOrderId], map: "idx_payment_orders_razorpay_order")
  @@index([bookingId], map: "idx_payment_orders_booking_id")
  @@index([status, updatedAt, amountPaise], map: "idx_payment_orders_status_updated_amount")
  @@map("payment_orders")
}

model Rating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @unique @map("booking_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  ratingScore Int      @map("rating_score")
  reviewText  String?  @map("review_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerId, ratingScore], map: "idx_ratings_provider_score")
  @@index([customerId], map: "idx_ratings_customer")
  @@map("ratings")
}

model PushToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  userRole   String   @map("user_role") @db.VarChar(50)
  deviceId   String   @map("device_id") @db.VarChar(255)
  fcmToken   String   @map("fcm_token") @db.Text
  platform   String   @default("ANDROID") @map("platform") @db.VarChar(20)
  isActive   Boolean  @default(true) @map("is_active")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, deviceId], map: "uq_push_tokens_user_device")
  @@unique([fcmToken], map: "uq_push_tokens_fcm_token")
  @@index([userId], map: "idx_push_tokens_user_id")
  @@map("push_tokens")
}

model ProviderLead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(150)
  mobileNumber   String   @map("mobile_number") @db.VarChar(20)
  serviceArea    String   @map("service_area") @db.VarChar(100)
  isAcknowledged Boolean  @default(false) @map("is_acknowledged")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([isAcknowledged, createdAt], map: "idx_leads_acknowledged")
  @@map("provider_leads")
}

model DailyAnalytics {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                      DateTime @unique @db.Date
  bookingCount              Int      @default(0) @map("booking_count")
  completedBookings         Int      @default(0) @map("completed_bookings")
  cancelledBookings         Int      @default(0) @map("cancelled_bookings")
  revenuePaise              BigInt   @default(0) @map("revenue_paise")
  onlineRevenuePaise        BigInt   @default(0) @map("online_revenue_paise")
  cashSettledRevenuePaise   BigInt   @default(0) @map("cash_settled_revenue_paise")
  completedCashRevenuePaise BigInt   @default(0) @map("completed_cash_revenue_paise")
  unassignedCount           Int      @default(0) @map("unassigned_count")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("daily_analytics")
}

